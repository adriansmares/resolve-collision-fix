# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
import os, sys

projectName = 'l4d2_resolve_collision_fix'

# smsdk_ext.cpp will be automatically added later
sourceFiles = [
  'source/debugoverlay.cpp',
  'source/extension.cpp',
  'source/resolve_collision_tools.cpp',
  'source/util_shared.cpp',
  'source/takedamageinfohack.cpp',
  os.path.join(Extension.sm_root, 'public', 'CDetour', 'detours.cpp'),
  # SourceMod's CDetour is built on safetyhook, pinned to the same commit as SourceMod's public/safetyhook.
  'safetyhook/zydis/Zydis.c',
  'safetyhook/src/allocator.cpp',
  'safetyhook/src/easy.cpp',
  'safetyhook/src/inline_hook.cpp',
  'safetyhook/src/mid_hook.cpp',
  'safetyhook/src/os.windows.cpp' if builder.target_platform == 'windows' else 'safetyhook/src/os.linux.cpp',
  'safetyhook/src/utility.cpp',
  'safetyhook/src/vmt_hook.cpp',
]

includeFiles = [
  os.path.join(builder.sourcePath, 'source', 'sdk'),
  os.path.join(builder.sourcePath, 'source'),
]

# Zydis.c is C, so safetyhook's include paths are needed for C and C++ alike.
safetyhookIncludes = [
  os.path.join(builder.sourcePath, 'safetyhook', 'include'),
  os.path.join(builder.sourcePath, 'safetyhook', 'zydis'),
]

###############
# Make sure to edit PackageScript, which copies your files to their appropriate locations
# Simple extensions do not need to modify past this point.

project = Extension.HL2Project(builder, projectName + '.ext')

if os.path.isfile(os.path.join(builder.currentSourcePath, 'sdk', 'smsdk_ext.cpp')):
  # Use the copy included in the project
  project.sources += [os.path.join('sdk', 'smsdk_ext.cpp')]
else:
  # Use the copy included with SM 1.6 and newer
  project.sources += [os.path.join(Extension.sm_root, 'public', 'smsdk_ext.cpp')]

project.sources += sourceFiles

for sdk_name in Extension.sdks:
  sdk = Extension.sdks[sdk_name]
  
  binary = Extension.HL2Config(project, projectName + '.ext.' + sdk.ext, sdk)
  compiler = binary.compiler
  compiler.cxxincludes += includeFiles
  compiler.includes += safetyhookIncludes
  
  if compiler.vendor == 'msvc':
    compiler.defines += [ '_CRT_NO_VA_START_VALIDATION' ]
    compiler.cxxflags.append('/std:c++17')
    compiler.cxxflags.append('/Ob0')
    compiler.cxxflags.append('/Oi-')
    compiler.linkflags.append('legacy_stdio_definitions.lib')
    compiler.linkflags.append('Ws2_32.lib')
  elif compiler.vendor == 'clang':
    compiler.cxxflags += [ '-Wno-reinterpret-base-class', '-Wno-infinite-recursion', '-Wno-implicit-const-int-float-conversion', '-std=c++17', '-Wno-register', '-Wno-varargs' ]
    if compiler.version >= 'clang-20':
      # hl2sdk's vphysics_interface.h memsets non-trivial types; clang 20 started warning about it.
      compiler.cxxflags += [ '-Wno-nontrivial-memcall' ]
    compiler.defines += [ 'HAVE_STRING_H', '_GLIBCXX_USE_CXX11_ABI=0' ]
    compiler.linkflags += [ '-static-libstdc++' ]
	
Extension.extensions = builder.Add(project)
